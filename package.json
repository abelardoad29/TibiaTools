{
  "name": "tibia-tools",
  "productName": "Tibia Tools",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Herramientas de Tibia + análisis de arbitraje del Market (uso personal, local).",
  "author": "abelardoad29",
  "type": "module",
  "main": "./out/main/index.js",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.7.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.66.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:web": "vite build --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "ocr:calibrate": "tsx scripts/calibrate-market.ts",
    "check": "npm run typecheck && npm run lint && npm run depcruise && npm run test",
    "seed:fetch": "node scripts/fetch-seeds.ts",
    "seed:imbuements": "node scripts/parse-imbuements.ts",
    "ocr:eval": "tsx scripts/ocr-eval.ts",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "icon": "tsx scripts/make-icon.ts",
    "seed:imbuable": "node scripts/fetch-imbuable.ts",
    "seed:bosses": "node scripts/build-boss-stats.ts"
  }
}
